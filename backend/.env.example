# ==========================================
# SimTrade Backend Environment Variables
# ==========================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/simtrade
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Alpaca Broker API (Sandbox Endpoint)
BROKER_API_KEY=your_broker_api_key_here
BROKER_API_SECRET=your_broker_api_secret_here

# Alpaca Trading & Market Data API (Paper Trading)
TRADING_API_KEY=your_trading_api_key_here
TRADING_API_SECRET=your_trading_api_secret_here
